APP_NAME="ScenePulse by Flownie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- QLOO CULTURAL AI CONFIGURATION ---
QLOO_SERVER_URL=https://hackathon.api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_CACHE_TTL_HOURS=168

# --- MULTIMODAL & AI GATEWAY CONFIGURATION ---
AI_DEFAULT_PROVIDER=nebius
DAILY_LIVE_LLM_CAP=250
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
NEBIUS_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_VISION_MODEL=google/gemma-3-27b-it

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat
OPENROUTER_FAST_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=google/gemma-3-27b-it

GEMINI_API_KEY=
